APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# PREM-D03 — private disk for Cloud backup snapshots (must never be `public`).
CLOUD_BACKUP_DISK=cloud_backups
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SEO — set true only when APP_URL points to the public production domain.
SEO_INDEXABLE=false
SEO_SITE_NAME="NexaPOS"
SEO_TITLE="NexaPOS - Sistem POS untuk Operasional Bisnis"
SEO_DESCRIPTION="NexaPOS membantu bisnis mengelola penjualan, produk, stok, laporan, outlet, dan sinkronisasi Cloud dalam satu platform POS."
SEO_KEYWORDS="sistem POS, aplikasi kasir, software kasir, manajemen stok, laporan penjualan, POS Indonesia"
SEO_LOCALE=id_ID
# Optional absolute URL or public path to a 1200x630 social sharing image.
# SEO_IMAGE=

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Google Sign-In (AUTH-D04). Required whenever the mobile app or the dashboard
# /login page offers "Sign in with Google": an empty GOOGLE_CLIENT_ID makes
# POST /api/v2/auth/google return 503 GOOGLE_AUTH_NOT_CONFIGURED and hides the
# web button. Use the OAuth *web* client ID for the server audience, add the
# dashboard origin to its Authorized JavaScript origins, and list every Android
# client ID that can mint ID tokens for the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_IDS=
